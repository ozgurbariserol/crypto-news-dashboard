# Copy to .env and fill in your own values. .env is git-ignored. Never commit real credentials.

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newsdb
POSTGRES_PORT=5432

# --- Backend (ASP.NET Core reads this as ConnectionStrings:postgres) ---
# Keep user/password/db identical to the values above.
# PowerShell:  $env:ConnectionStrings__postgres = "Host=localhost;Port=5432;Database=newsdb;Username=postgres;Password=change-me"
# bash:        export ConnectionStrings__postgres="Host=localhost;Port=5432;Database=newsdb;Username=postgres;Password=change-me"
ConnectionStrings__postgres=Host=localhost;Port=5432;Database=newsdb;Username=postgres;Password=change-me

# --- Optional: addresses of the external services the backend calls ---
# (defaults shown; those services are NOT part of this repository)
# Services__Collector=http://127.0.0.1:80
# Services__Prediction=http://127.0.0.1:12000

# --- Frontend (Vite) ---
VITE_BACKEND_URL=http://localhost:5000
